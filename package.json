{
  "name": "anime-sama-downloader",
  "version": "1.0.0",
  "description": "Electron downloader for anime streams",
  "main": "main.ts",
  "scripts": {
    "start": "npx electron main.ts",
    "start:cli": "node adapters/cli/Cli.ts",
    "start:download": "node auto-download/FileReader.js",
    "build": "electron-builder",
    "test": "npx mocha --timeout 30000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@inquirer/prompts": "^8.0.2",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "child_process": "^1.0.2",
    "cli-progress": "^3.12.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "progress": "^2.0.3",
    "puppeteer": "^24.30.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io": "^4.8.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tslog": "^4.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "electron-builder": "^26.8.1",
    "electron": "^41.1.1"
  },
  "sourceType": "module",
  "build": {
    "appId": "com.anime-sama-downloader.app",
    "productName": "Anime Sama Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!build/**/*",
      "!test/**/*",
      "!*.md",
      "!eslint.config.*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
